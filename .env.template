MYSQL_PASSWORD=PDPHOTOS

# ── Nextcloud admin (first boot only) ───────────────────────────────────────
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=PDPHOTOS

# ── Your Cloudflare tunnel public hostname ───────────────────────────────────
# e.g. files.yourdomain.com
NEXTCLOUD_TRUSTED_DOMAIN=divyanshu-palak-wedding.space

# ── Cloudflare tunnel token ──────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Path to your SSD on the host ────────────────────────────────────────────
# e.g. /media/my_ssd   or   /dev/sdb1 (use the mount-point, not the device)
SSD_PATH=

IMMICH_VERSION=release
IMMICH_DB_PASSWORD=

# ── AI Pipeline ──────────────────────────────────────────────────────────────
# Get from Immich: Account Settings → API Keys
IMMICH_API_KEY=

# Ollama runs natively on Mac — these defaults work for both host and Docker
OLLAMA_BASE_URL=http://localhost:11434

